+  async completeEmailLinkFromUrl(
+    url: string,
+  ): Promise<VerifiedAuth | null> {
+    const callbackUrl = new URL(url)
+    const code = callbackUrl.searchParams.get('code')
+    const callbackError = callbackUrl.searchParams.get('error')
+
+    if (!code && !callbackError) return null
+
+    try {
+      if (!code) {
+        throw new Error(
+          'The sign-in link could not be completed. Request a fresh email and try again.',
+        )
+      }
+
+      const { data, error } =
+        await supabase.auth.exchangeCodeForSession(code)
+
+      if (error) throw error
+      if (!data.user || !data.session) {
+        throw new Error('Email link did not create a valid session')
+      }
+
+      const verified = await supabase.auth.getUser()
+      if (verified.error || !verified.data.user) {
+        throw verified.error ?? new Error('Unable to verify authenticated user')
+      }
+
+      if (verified.data.user.id !== data.user.id) {
+        throw new Error('Authenticated identity mismatch')
+      }
+
+      return {
+        user: verified.data.user,
+        session: data.session,
+      }
+    } finally {
+      clearAuthCallbackFromUrl(callbackUrl)
+    }
+  }
