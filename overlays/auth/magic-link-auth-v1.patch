+function clearAuthCallbackFromUrl(callbackUrl: URL): void {
+  if (typeof window === 'undefined') return
+
+  for (const key of ['code', 'error', 'error_code', 'error_description']) {
+    callbackUrl.searchParams.delete(key)
+  }
+
+  const cleanUrl =
