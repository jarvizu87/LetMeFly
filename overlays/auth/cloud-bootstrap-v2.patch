+  private async flushBootstrapOutbox(engine: LetMeFlySyncEngine): Promise<void> {
+    // A first sync can contain years of offline records, not just one 50-row
+    // batch. Drain successful batches, but stop on errors or lack of progress.
+    for (let batch = 0; batch < 100; batch += 1) {
+      const result = await engine.syncNow()
+      if (result.offline) throw new Error('Cloud sync paused while offline. Your local data is safe.')
+      if (!result.authenticated) throw new Error('Sign in again to finish cloud sync. Your local data is safe.')
+      if (result.conflicts > 0 || result.rejected > 0) {
+        throw new Error(`Cloud sync needs review: ${result.conflicts} conflicts, ${result.rejected} rejected. Your local data is safe.`)
+      }
+      if (result.pending === 0) return
+      if (result.pushed === 0) {
+        throw new Error(`Cloud sync paused with ${result.pending} pending changes. Retry Sync Now when connected.`)
+      }
+    }
+    throw new Error('Cloud sync has more pending changes. Tap Sync Now to continue safely.')
+  }
