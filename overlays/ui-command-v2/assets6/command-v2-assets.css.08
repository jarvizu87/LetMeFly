");}
/* Reuse governed cinematic assets across the visual family without external network dependencies. */
.program-hero{background-image:linear-gradient(90deg,#071016 18%,rgba(7,16,22,.72) 55%,rgba(7,16,22,.15)),var(--v2-mountain)!important;background-size:auto,58% 100%!important;background-position:0 0,right center!important;background-repeat:no-repeat!important}
.bc-phase{position:relative;overflow:hidden}
.bc-phase::after{content:'';position:absolute;inset:0;pointer-events:none;opacity:.22;background:linear-gradient(90deg,rgba(3,7,10,.88),rgba(3,7,10,.15)),var(--v2-mountain) right center/58% 170% no-repeat}
.bc-phase>*{position:relative;z-index:1}
.bc-phase.volume::after{filter:hue-rotate(245deg) saturate(1.7)}
.bc-phase.intensification::after{filter:hue-rotate(330deg) saturate(2)}
.bc-phase.realization::after{filter:grayscale(.7) brightness(.85)}
.more-brand,.settings-brand{background-image:linear-gradient(180deg,rgba(3,7,10,.24),#05090d 88%),var(--v2-mountain)!important}
