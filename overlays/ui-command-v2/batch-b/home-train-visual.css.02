y{font-size:9.5px}.command-hero .hero-progress{left:15px;right:15px}.focus-chip{min-height:66px;font-size:6.6px}.focus-chip span{font-size:16px}.dashboard-grid{grid-template-columns:1fr}.readiness-ring{width:76px;height:76px}}

/* TRAIN — immersive current-section experience, without changing prescriptions. */
.train-shell{max-width:760px}.train-header{padding:3px 2px 7px}.train-header h1{font-size:26px;line-height:.98}.train-header .badge{margin-top:2px}.train-header p{max-width:610px}
.session-track{margin-top:2px;margin-bottom:8px}.session-track button{min-height:48px!important;padding-top:22px!important}.session-track button::before{top:7px}.session-track button.active::before{box-shadow:0 0 18px rgba(255,23,49,.52)}
.day-strip{margin-bottom:8px}.day-chip{min-height:49px;border-radius:6px}.day-chip.active{box-shadow:inset 0 0 0 1px #ff1731}
.train-rule{border-radius:7px;margin:5px 0 8px;padding:8px 10px}.train-rule strong{font-size:7px;letter-spacing:.12em}.train-rule span{font-size:8px;line-height:1.35}
.swipe-meta{margin-top:4px}.session-nav{margin:5px 0 9px}.session-nav-btn{width:40px;height:40px}.session-nav span{font-size:9px;letter-spacing:.15em}
.workout-panel{padding:9px;min-height:540px}.workout-panel-head{padding:3px 3px 8px}.workout-panel-head h2{font-size:21px}.exercise-stack{gap:9px}
.exercise-card{border-radius:7px!important;background:#071016!important;border-color:#263640!important;overflow:hidden}
.exercise-stack .exercise-card:first-child::before{content:'';display:block;height:188px;margin:-1px -1px 10px;background-image:linear-gradient(180deg,rgba(2,5,8,.04),rgba(2,5,8,.10) 42%,rgba(2,5,8,.84)),var(--v2-lifter);background-size:cover;background-po