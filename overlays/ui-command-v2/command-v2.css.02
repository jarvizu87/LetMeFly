ss-graphic span{color:#ff293f}.readiness-options span{border-radius:4px}.readiness-options input:checked+span{background:#ff1731;border-color:#ff1731}.review-panel{background:radial-gradient(circle at 50% 10%,rgba(255,23,46,.13),transparent 35%),#060b0f!important}

/* PROGRAM — Black Crown roadmap cards from the approved concept */
.program-hero{position:relative;overflow:hidden;border-radius:9px!important;min-height:185px;padding:18px;background:linear-gradient(90deg,#071016 20%,rgba(7,16,22,.78) 55%,rgba(7,16,22,.35)),var(--v2-mountain) right center/55% 100% no-repeat!important}.program-hero h2{font-size:30px}.program-hero p{max-width:600px;color:#aeb8c0;font-size:11px}.program-progress{min-width:200px}.program-week-nav{border-radius:7px;background:#080e13;border-color:#26333d}.program-week-nav button{border-radius:4px}.program-week-nav button.active{background:#ff1731;border-color:#ff1731}
.phase-roadmap{gap:7px}.phase-card{border-radius:7px;padding:12px;background:#091117;border-color:#24313b}.phase-card.active{border-color:#ff1731;background:linear-gradient(125deg,rgba(255,23,46,.16),#091117)}
.black-crown-panel{border-radius:10px;overflow:hidden;padding:0!important;background:#05090d!important}.black-crown-copy{padding:18px;background:radial-gradient(circle at 10% 0,rgba(255,23,46,.09),transparent 42%)}.black-crown-phases{gap:8px;padding:10px}.bc-phase{min-height:114px;border-radius:8px!important;padding:15px!important;position:relative;overflow:hidden;background-size:cover!important;background-position:center!important;border:1px solid #37434c!important}.bc-phase::before{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(3,7,10,.88),rgba(3,7,10,.25))}.bc-phase>*{position:relative;z-index:1}.bc-phase span{font-size:11px}.bc-phase strong{font-size:24px;letter-spacing:.03em}.bc-phase small{font-size:9px}.bc-phase.foundation{background-image:var(--v2-mountain)!important}.bc-phase.volume{background-image:var(--v2-mountain)!important;border-color:#7c2bb3!important}.bc-phase.intensity{background-image:var(--v2-mountain)!important;border-color:#a0182b!important}.bc-phase.realization{background-image:var(--v2-mountain)!important}
.week-grid{gap:6px}.week-day-card{border-radius:6px!important}.week-day-card.active{border-color:#ff1731!important}.source-details{border-radius:7px!important}

/* PROGRESS — dense analytics board */
.progress-score-grid{gap:7px}.score-card{border-radius:7px;padding:11px;background:#081016;border-color:#25323b}.score-card.hero-score{background:linear-gradient(135deg,rgba(255,23,46,.12),#081016)}.score-card span{font-size:7px}.score-card strong{font-size:22px}.tm-board{border-radius:8px;padding:12px}.tm-grid{gap:6px}.tm-card{border-radius:5px;background:#071016;border-color:#25333d;padding:9px}.tm-card span{font-size:8px}.tm-input,.tm-unit{background:#050b0f;border-color:#2b3944}.history-list{gap:5px}.history-card{border-radius:6px;background:#071016;border-color:#24313b}.history-icon{background:#0b2b20;color:#5ef0a9}
.v2-analytics{display:grid;grid-template-columns:1.4fr .8fr;gap:8px;margin:8px 0}.v2-chart,.v2-volume{border:1px solid #25333d;border-radius:7px;background:#071016;padding:10px}.v2-chart-title{display:flex;justify-content:space-between;align-items:end;margin-bottom:8px}.v2-chart-title span{font-size:8px;color:#8d99a3}.v2-chart-title strong{font-family:var(--condensed);font-size:24px}.v2-bars{height:128px;display:flex;align-items:end;gap:5px;border-left:1px solid #1e2a33;border-bottom:1px solid #1e2a33;padding:8px}.v2-bars i{flex:1;display:block;min-height:8px;background:linear-gradient(180deg,#ff1731,#6c101e);border-radius:2px 2px 0 0}.v2-volume-grid{display:grid;grid-template-columns:repeat(4,1fr);align-items:end;height:105px;gap:4px}.v2-volume-grid span{background:#536375;border-radius:2px 2px 0 0}

/* EXERCISES — image-forward list */
.exercise-search-card{border-radius:7px!important;padding:8px!important;position:sticky;top:66px;z-index:20;backdrop-filter:blur(18px)}.search-wrap{border-radius:5px;background:#050b0f;border-color:#2b3944}.filter-chips{gap:4px}.filter-chips button{border-radius:4px;font-size:7px}.filter-chips button.active{background:#ff1731;border-color:#ff1731}.exercise-library{gap:5px}.library-card{grid-template-columns:74px 1fr auto!important;border-radius:6px!important;padding:5px!important;min-height:82px}.library-thumb{height:72px!important;border-radius:4px!important;background:linear-gradient(180deg,rgba(0,0,0,.05),rgba(0,0,0,.5)),var(--v2-lifter) center/cover no-repeat!important}.library-thumb span{display:none}.library-thumb b{display:none}.library-card[data-filter-tags~="kb"] .library-thumb,.library-card[data-filter-tags~="carry"] .library-thumb{background-image:linear-gradient(180deg,rgba(0,0,0,.05),rgba(0,0,0,.45)),var(--v2-wolf)!important}.library-copy h3{font-size:17px;margin:1px 0}.library-copy p{font-size:7px;color:#788590;margin:2px 0}.library-copy .btn-row{display:none}.library-card:hover .btn-row,.library-card:focus-within .btn-row{display:flex}.exercise-results{font-size:8px}

/* COACH */
.coach-banner{border-radius:8px;padding:12px;background:linear-gradient(100deg,rgba(4,9,13,.78),rgba(4,9,13,.95)),var(--v2-wolf) right 35%/auto 170% no-repeat;border:1px solid #26343e}.coach-avatar{width:48px;height:48px;border-radius:50%;background:#070c11;border:1px solid #4a5862}.coach-banner h1{font-size:28px}.coach-layout{gap:7px}.coach-context,.coach-chat{border-radius:7px}.coach-message{border-radius:6px;background:#071016}.quick-prompts button{border-radius:5px;background:#071016;border-color:#2b3944;padding:9px}.coach-composer textarea{border-radius:5px;background:#050a0e;border-color:#2b3944}

/* PROFILE */
.profile-hero{border-radius:9px!important;background:linear-gradient(90deg,rgba(5,10,14,.95),rgba(5,10,14,.7)),var(--v2-mountain) right/50% 100% no-repeat!important}.profile-avatar{border-radius:50%;border-color:#78838c;background:radial-gradient(circle,#313a43,#080d11)}.profile-identity h2{