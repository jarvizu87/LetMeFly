/* LetMeFly Command V2 — Option 1 visual source of truth */
:root{
  --v2-wolf:url("data:image/svg+xml;base64,");
  --v2-mountain:url("data:image/svg+xml;base64,");
  --v2-lifter:url("data:image/svg+xml;base64,");
  --v2-bg:#05080b;--v2-panel:#091016;--v2-panel-2:#0d151d;--v2-line:#23303a;
  --v2-red:#ff172e;--v2-red-2:#9e0e20;--v2-purple:#a42cff;--v2-green:#48e39b;
  --v2-gold:#e5ae56;--v2-text:#f7f8fa;--v2-muted:#84919d;
}
html{background:#030609}
body{background:
  radial-gradient(circle at 16% -10%,rgba(255,23,46,.08),transparent 28%),
  radial-gradient(circle at 90% 15%,rgba(105,33,175,.06),transparent 28%),#030609;color:var(--v2-text)}
.app-shell{background:transparent}
main{max-width:1520px;margin:0 auto}

/* Header + navigation: reference keeps the chrome quiet so content dominates. */
.topbar{min-height:64px;background:rgba(2,6,9,.96);border-bottom:1px solid #16202a;padding:8px 14px}
.brand-mark{width:32px;height:32px;background:transparent;border:0;clip-path:none;box-shadow:none;color:#fff;font-size:18px}
.brand-mark::before{content:'♛'}
.brand-word{font-size:15px;letter-spacing:.23em}.brand small{font-size:6px;letter-spacing:.22em;color:#65717c}
.topbar-context{opacity:.8}.sync-pill{background:#0a1118;border-color:#202d38;font-size:8px;padding:7px 9px}
.navbar{background:rgba(3,7,10,.97);border-top:1px solid #1d2832;padding-top:5px}
.nav-item{color:#7d8892;font-size:8px;padding:6px 2px;min-height:56px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;border-radius:0}
.nav-item span{font-size:16px;margin:0}.nav-item.active{color:#ff2438;background:linear-gradient(180deg,rgba(255,23,46,.1),transparent 80%);box-shadow:inset 0 2px 0 var(--v2-red)}

/* Shared Command V2 surfaces */
.card,.program-hero,.week-day-card,.library-card,.more-card,.exercise-search-card,.source-details,.action-tile{
  border-color:var(--v2-line)!important;background:linear-gradient(145deg,rgba(13,21,29,.98),rgba(6,11,16,.99))!important;
  box-shadow:0 14px 40px rgba(0,0,0,.2)
}
.page-kicker,.exercise-eyebrow{color:#ff4050!important;font-weight:900;letter-spacing:.14em}
.cinematic-head{padding:4px 2px 10px}.cinematic-head h1{font-size:clamp(34px,8vw,60px);letter-spacing:.05em}
.btn{border-radius:5px;font-weight:900;letter-spacing:.045em}.btn.primary{background:linear-gradient(180deg,#ff1731,#e40b26);border-color:#ff233b;color:white;box-shadow:0 8px 24px rgba(255,23,46,.18)}
.btn.ghost{background:#0a1117;border-color:#33414d;color:#f3f6f8}.btn.purple{background:linear-gradient(180deg,#b62cff,#7a20ce);border-color:#bc4cff}
.badge{border-radius:4px}.progress-bar{background:#1a252e}.progress-bar span{background:linear-gradient(90deg,#ff1430,#ff4156)}

/* HOME — Command dashboard */
.command-hero{min-height:470px;padding:0;overflow:hidden;border:1px solid #2a3742;border-radius:15px;background:#05090d;box-shadow:0 22px 55px rgba(0,0,0,.42);display:fle