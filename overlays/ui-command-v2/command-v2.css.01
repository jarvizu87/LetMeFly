x;align-items:flex-end}
.command-hero::before{content:'';position:absolute;inset:0;background:
  linear-gradient(180deg,rgba(3,7,10,.02) 0%,rgba(3,7,10,.12) 28%,rgba(3,7,10,.86) 68%,#05090d 100%),
  linear-gradient(90deg,rgba(3,7,10,.25),rgba(3,7,10,0) 50%,rgba(3,7,10,.32)),
  var(--v2-wolf) 84% 22%/auto 96% no-repeat,
  var(--v2-mountain) center top/100% auto no-repeat;
  filter:saturate(.9) contrast(1.05)}
.command-hero::after{content:'';position:absolute;inset:auto -15% -18% 20%;height:52%;background:radial-gradient(ellipse,rgba(255,18,44,.12),transparent 60%);transform:rotate(-7deg)}
.hero-art{display:none}.hero-content{position:relative;z-index:2;width:100%;max-width:none;padding:22px 20px 104px;background:linear-gradient(180deg,transparent,rgba(3,7,10,.55) 20%,rgba(3,7,10,.96) 68%)}
.hero-brandline{margin-bottom:8px}.hero-brandline span{font-size:10px;color:#d5d9dc;letter-spacing:.16em}.hero-brandline em{font-size:7px;color:#9aa5ae;background:#15202a;border-color:#25333f}
.hero-content .page-kicker{font-size:8px}.hero-title{font-size:clamp(35px,10vw,58px);line-height:.94;max-width:780px;text-shadow:0 2px 18px #000;margin:7px 0 10px;letter-spacing:-.015em}
.hero-copy{max-width:560px;color:#c0c8ce;font-size:12px;line-height:1.45;margin-bottom:10px}.hero-tags{gap:5px}.hero-tags span{font-size:7px;padding:5px 8px;border-color:#303d48;background:#111920}
.hero-actions{margin-top:12px}.hero-start{min-height:46px;min-width:220px}.hero-progress{z-index:3;left:20px;right:20px;bottom:18px;width:auto;background:rgba(4,9,13,.93);border:1px solid #26333d;border-radius:7px;padding:10px 12px}.hero-progress div:first-child span{font-size:7px}.hero-progress div:first-child strong{font-size:12px}
.focus-strip{margin:10px 0 12px;grid-template-columns:repeat(4,1fr);gap:7px}.focus-chip{min-height:62px;border:1px solid #202d37;border-radius:7px;background:#0a1117;padding:9px 6px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;font-size:8px;color:#d1d7dc;gap:4px}.focus-chip span{color:var(--v2-gold);font-size:16px;font-family:var(--condensed)}
.dashboard-grid{gap:8px}.status-card,.milestone-card,.coach-focus-card{border-radius:8px;padding:12px}.status-card h2,.milestone-card h2,.coach-focus-card h2{font-size:19px}.readiness-card{grid-column:auto}.readiness-rings{justify-content:space-around;margin:9px 0}.readiness-ring{width:78px;height:78px;border-width:2px;background:#071016}.readiness-ring strong{font-size:20px}.readiness-ring span{font-size:7px}.performance-list>div{padding:7px 0}.performance-list span{font-size:8px}.performance-list strong{font-size:10px}.milestone-card{background:linear-gradient(120deg,rgba(104,30,11,.28),#0a1117 45%)!important}.milestone-icon{color:var(--v2-gold);border-color:#76552a}.coach-focus-card .callout{font-size:9px}

/* TRAIN — immersive single-block workout */
.train-shell{max-width:880px;margin:0 auto}.train-header{padding:4px 2px 8px}.train-header h1{font-size:24px;letter-spacing:.01em}.train-header p{font-size:10px}.session-track{background:transparent;border:0;padding:2px 0 9px;display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:0;overflow:visible}
.session-track button{min-width:0!important;min-height:42px;background:transparent;border:0;border-bottom:1px solid #30404a;border-radius:0;color:#78848e;font-size:6px;padding:18px 1px 2px;position:relative;overflow:visible}.session-track button::before{content:'';position:absolute;left:50%;top:7px;transform:translateX(-50%);width:9px;height:9px;border:1px solid #7c8890;border-radius:50%;background:#05090d}.session-track button.active{color:#fff;background:transparent;border-color:var(--v2-red)}.session-track button.active::before{width:18px;height:18px;top:3px;border-color:#ff233b;background:#ff1731;box-shadow:0 0 14px rgba(255,23,46,.45)}
.day-strip{margin:0 -10px 4px;padding:2px 10px 7px}.day-chip{border-radius:5px;min-width:58px;background:#0a1117;border-color:#24303a}.day-chip.active{background:#191018;border-color:#ff233b;box-shadow:inset 0 0 0 1px rgba(255,23,46,.22)}
.train-rule{font-size:8px;padding:7px 9px;margin:4px 0 8px;border-left:2px solid var(--v2-purple);background:rgba(164,44,255,.045)}.swipe-meta{font-size:7px}.session-nav{margin:4px 0 8px}.session-nav span{font-size:9px;letter-spacing:.14em}.session-nav-btn{border-radius:50%;background:#0c141b;border-color:#34434e}
.swipe-viewport{gap:10px}.swipe-page{border-radius:8px;border-color:#26343f!important;background:#050a0e!important}.workout-panel{padding:10px;min-height:560px}.workout-panel-head{padding:2px 2px 8px}.workout-panel-head h2{font-size:20px}.section-number{font-size:10px}
.exercise-stack{gap:8px}.exercise-card{border:1px solid #293741;border-radius:7px;background:#071016;padding:9px;overflow:hidden}.active-exercise:first-child,.preview-card:first-child{padding-top:205px;position:relative;background:linear-gradient(180deg,transparent 0 34%,#071016 54%)!important}.active-exercise:first-child::before,.preview-card:first-child::before{content:'';position:absolute;inset:0 0 auto;height:208px;background:linear-gradient(180deg,rgba(0,0,0,.02),rgba(0,0,0,.05) 60%,#071016 100%),var(--v2-lifter) center 28%/cover no-repeat;z-index:0}.active-exercise:first-child>* ,.preview-card:first-child>*{position:relative;z-index:1}.exercise-title h3{font-size:24px;letter-spacing:.01em}.exercise-glyph{display:none}.exercise-title .icon-btn{background:#0b1319;border-color:#30404c}
.set-table{border-top:1px solid #202d36;margin-top:6px}.set-row{background:#0a1218;border-color:#22313b;border-radius:5px}.set-check{border-radius:5px}.set-check.done{background:#ff1731;border-color:#ff1731}.exercise-actions{display:grid;grid-template-columns:repeat(3,1fr);gap:5px}.exercise-actions .btn{font-size:7px;padding:7px 4px;min-height:40px}.exercise-actions .btn:last-child:nth-child(4){grid-column:1/-1}
.readiness-panel{background:radial-gradient(circle at 80% 18%,rgba(70,211,149,.08),transparent 24%),#071016!important}.readine