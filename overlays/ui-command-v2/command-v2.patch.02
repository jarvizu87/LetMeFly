ORGE.weekData.flatMap((week) => week.days.map((day) => ({ ...day, week: week.week })))
+  const dates = days.map((day) => day.date).filter(Boolean).sort()
+  const anchor = dates[0] ? new Date(`${dates[0]}T12:00:00`) : new Date()
+  const year = anchor.getFullYear()
+  const month = anchor.getMonth()
+  const monthName = anchor.toLocaleString(undefined, { month: 'long', year: 'numeric' })
+  const firstDay = new Date(year, month, 1).getDay()
+  const totalDays = new Date(year, month + 1, 0).getDate()
+  const byDate = new Map(days.map((day) => [day.date, day]))
+  const cells: string[] = []
+  for (let i = 0; i < firstDay; i++) cells.push('<div class="calendar-cell empty"></div>')
+  for (let d = 1; d <= totalDays; d++) {
+    const iso = `${year}-${String(month + 1).padStart(2,'0')}-${String(d).padStart(2,'0')}`
+    const item = byDate.get(iso)
+    const rest = item?.restDay ?? false
+    cells.push(`<div class="calendar-cell ${rest ? 'rest' : ''}"><strong>${d}</strong>${item ? `<span class="dot"></span><button data-calendar-week="${item.week}" data-calendar-day="${item.day}" aria-label="Open ${esc(item.title)}"></button>` : ''}</div>`)
+  }
+  return `<div class="calendar-shell"><div class="page-head cinematic-head"><div class="page-kicker">Plan & stay on track</div><h1>CALENDAR</h1><p class="muted">${esc(monthName)} • governed Crownforge schedule</p></div><section class="card"><div class="calendar-grid">${['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].map((x) => `<div class="calendar-head">${x}</div>`).join('')}${cells.join('')}</div></section><div class="calendar-list">${days.slice(0,12).map((day) => `<div class="calendar-event ${day.restDay ? 'rest' : ''}"><i></i><div><strong>${esc(day.date)} • ${esc(day.title)}</strong><small>${esc(day.role)}</small></div><span>W${day.week} D${day.day}</span></div>`).join('')}</div></div>`
+}
