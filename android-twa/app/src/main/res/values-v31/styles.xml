<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LetMeFly" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/letmefly_background</item>
        <item name="android:navigationBarColor">@color/letmefly_background</item>
        <item name="android:statusBarColor">@color/letmefly_background</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/letmefly_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/letmefly_logo</item>
    </style>
</resources>
